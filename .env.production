# ========================
# 银发通 生产环境配置
# 部署到 ECS 时复制为 .env
# ========================

# 应用
APP_NAME=银发通
APP_VERSION=1.0.0
DEBUG=false

# 数据库（Docker 内部通信）
DB_HOST=mysql
DB_PORT=3306
DB_USER=root
DB_PASSWORD=yft_Prod_2026!
DB_NAME=yinfa_tong

# Redis（Docker 内部通信，需设密码）
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=yft_redis_2026
REDIS_DB=0

# RabbitMQ
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=yft
RABBITMQ_PASSWORD=yft_mq_2026

# Elasticsearch
ES_HOST=elasticsearch
ES_PORT=9200

# JWT（生产必须用随机值，首次部署时用 openssl rand -base64 48 生成）
JWT_SECRET_KEY=CHANGE_ME_ON_DEPLOY
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440

# 文件上传
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=10

# Dify AI
DIFY_API_KEY=app-FpWSqI3uI8khXAJrO4ESHtyR
DIFY_BASE_URL=https://api.dify.ai
DIFY_APP_MODE=chatflow
DIFY_TIMEOUT=60
DIFY_MAX_RETRIES=1

# 支付宝沙箱
ALIPAY_APP_ID=9021000164696230
ALIPAY_PRIVATE_
ALIPAY_PUBLIC_
ALIPAY_GATEWAY=https://openapi-sandbox.dl.alipaydev.com/gateway.do
ALIPAY_NOTIFY_URL=http://118.31.120.180/api/payment/notify
ALIPAY_RETURN_URL=http://118.31.120.180/pay-result
ALIPAY_OAUTH_REDIRECT_URI=http://118.31.120.180/auth/callback
PAY_MODE=sandbox

# 管理员注册码
ADMIN_REGISTER_CODE=yft-admin-2026
