# ========================
# 应用配置
# ========================
APP_NAME=银发通
APP_VERSION=1.0.0
DEBUG=true

# ========================
# 数据库
# ========================
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=root123
DB_NAME=yinfa_tong
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=40

# ========================
# Redis
# ========================
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ========================
# RabbitMQ
# ========================
RABBITMQ_HOST=127.0.0.1
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest

# ========================
# Elasticsearch
# ========================
ES_HOST=127.0.0.1
ES_PORT=9200

# ========================
# JWT
# ========================
JWT_SECRET_KEY=change-me-jwt-secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ========================
# 文件上传
# ========================
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=10

# ========================
# Dify AI Chatflow（智能导诊）
# ========================
# 获取方式：Dify Cloud → 左侧 API 访问 → 创建密钥 → 复制 app-xxx
DIFY_API_KEY=
DIFY_BASE_URL=https://api.dify.ai
# chatflow = Chatflow 模式 | chatbot = 聊天助手模式
DIFY_APP_MODE=chatflow
DIFY_TIMEOUT=30
DIFY_MAX_RETRIES=1
